# 复制成 .env 并按需修改；也可以直接 export 后用 uvicorn 起服务。
# 原则：**默认值就是生产可用值**。能改的都是"环境差异"，不是"还没调优"。

# ---------- 模型 ----------
# 默认用 INT8；想对比 FP32 就改成对应的 onnx 文件名
DOGBREED_MODEL_FILE=dogbreed_resnet50_64_int8.onnx
# DOGBREED_MODEL_DIR=./weights
# DOGBREED_MODEL_META=./weights/model_meta.json

# ---------- 日志 ----------
# 容器里建议开：一行一条 JSON，可直接被 filebeat/promtail/jq 消费
DOGBREED_LOG_JSON=0
DOGBREED_LOG_LEVEL=INFO
DOGBREED_LOG_DIR=./logs

# ---------- 反馈闭环 ----------
DOGBREED_FEEDBACK=1
DOGBREED_FEEDBACK_DIR=./feedback
DOGBREED_FEEDBACK_MAX_PER_DAY=2000

# ---------- 并发与超时 ----------
ORT_INTRA_OP_THREADS=1
MAX_INFLIGHT=8
QUEUE_WAIT_S=2.0
INFER_TIMEOUT_S=3.0
READ_TIMEOUT_S=10.0

# ---------- 输入限制 ----------
MAX_FILE_BYTES=5242880        # 5MB
MAX_BATCH=32
MAX_IMAGE_PIXELS=32000000
